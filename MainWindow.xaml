<Window x:Class="SecureMemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureMemo" Height="680" Width="1100" MinWidth="760" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 메모 목록 아이템 -->
        <Style x:Key="MemoItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="0,1">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                        Margin="0,10" Background="{StaticResource AccentBrush}" Visibility="Hidden"/>
                                <ContentPresenter Margin="14,10,8,10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25253a"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 원형 재생 버튼 -->
        <Style x:Key="RoundPlayButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#141417"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="White"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#d8d8e4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 플레이스홀더 텍스트 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 타이틀바 ===== -->
            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SecureMemo" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="최소화"
                            Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="최대화"
                            Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="닫기"
                            Style="{StaticResource CloseCaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ===== 메인 컨텐츠 ===== -->
            <Grid Grid.Row="1" x:Name="MainContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 -->
                        <Grid Grid.Row="0" Margin="16,14,12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="모든 메모" Foreground="{StaticResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MemoCountText" Foreground="{StaticResource FaintBrush}"
                                           FontSize="13" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="NewMemo_Click"
                                    Style="{StaticResource PrimaryButton}" Padding="12,7"
                                    ToolTip="새 메모 (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="새 메모" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 검색 -->
                        <Grid Grid.Row="1" Margin="12,0,12,8">
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="30,7,10,7"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <TextBlock Text="메모 검색 (Ctrl+F)" Margin="31,0,0,0" FontSize="13"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 목록 -->
                        <ListBox Grid.Row="2" x:Name="MemoListBox"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="8,0,4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource MemoItem}"
                                 SelectionChanged="MemoListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat='yyyy.MM.dd HH:mm'}"
                                                           Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4"
                                                        Background="{StaticResource AccentSoftBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAudio}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                   Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="녹음" FontSize="10" Margin="3,0,0,0"
                                                                   Foreground="{StaticResource AccentHoverBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                FontSize="12" Click="DeleteMemo_Click" Tag="{Binding}"
                                                ToolTip="삭제" VerticalAlignment="Top" Margin="4,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="ListEmptyText" Grid.Row="2" Text="메모가 없습니다"
                                   Foreground="{StaticResource FaintBrush}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

                        <!-- 하단 -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                Padding="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Click="Settings_Click" Style="{StaticResource GhostButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="설정" Margin="8,0,0,0" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Lock_Click" Style="{StaticResource GhostButton}"
                                            ToolTip="잠그고 다른 비밀번호로 열기 (Ctrl+L)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="잠그기" Margin="8,0,0,0" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="개발자에게 커피 사주기"
                                            Click="CoffeeBanner_Click" Style="{StaticResource GhostButton}"/>
                                    <Button Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="개발자 블로그 보기"
                                            Click="BlogBanner_Click" Style="{StaticResource GhostButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 에디터 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 상단 툴바 -->
                    <Grid Grid.Row="0" Margin="36,16,20,0">
                        <TextBlock x:Name="MetaText" Foreground="{StaticResource FaintBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- 녹음 중 표시 -->
                            <Border x:Name="RecordingIndicator" Background="#3a1d24" CornerRadius="6"
                                    Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed"
                                    ToolTip="녹음 중에 입력한 내용은 녹음 시점과 연결됩니다">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="{StaticResource RecordBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecordTimeText" Text="00:00" Foreground="{StaticResource RecordBrush}"
                                               FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"/>
                                    <TextBlock Text="· 입력 내용이 녹음과 연결됨" Foreground="#c98a93"
                                               FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="RecordButton" Click="Record_Click" Style="{StaticResource ModernButton}"
                                    Margin="0,0,8,0" ToolTip="녹음 시작/중지 (Ctrl+R)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RecordIcon" Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecordLabel" Text="녹음" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportWordButton" Click="ExportWord_Click" Style="{StaticResource ModernButton}"
                                    ToolTip="Word 문서로 내보내기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Word" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 제목 -->
                    <Grid Grid.Row="1" Margin="32,10,32,4">
                        <TextBox x:Name="TitleTextBox"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0" FontSize="26" FontWeight="SemiBold" Padding="2,4"
                                 TextChanged="TitleTextBox_TextChanged"/>
                        <TextBlock Text="제목 없음" FontSize="26" FontWeight="SemiBold" Margin="6,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=TitleTextBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 본문 + 녹음 하이라이트 오버레이 -->
                    <Grid Grid.Row="2" Margin="32,0,20,12">
                        <TextBox x:Name="ContentTextBox"
                                 Background="Transparent" Foreground="#d6d6de"
                                 CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0" FontSize="15" Padding="2,8,12,8"
                                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="ContentTextBox_TextChanged"
                                 SizeChanged="ContentTextBox_SizeChanged"
                                 PreviewMouseLeftButtonDown="ContentTextBox_PreviewMouseLeftButtonDown"/>
                        <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                        <TextBlock Text="여기에 메모를 작성하세요..." FontSize="15" Margin="6,9,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=ContentTextBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 재생 바 -->
                    <Border x:Name="PlayerBar" Grid.Row="3" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Padding="20,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PlayButton" Grid.Column="0" Content="&#xE768;" Click="Play_Click"
                                    Style="{StaticResource RoundPlayButton}" ToolTip="재생 / 일시정지"/>

                            <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00" Width="52"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,10,0"/>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 메모 작성 지점 표시 -->
                                <Canvas x:Name="MarkTicksCanvas" Grid.Row="0" Margin="6,0" ClipToBounds="False"
                                        SizeChanged="MarkTicksCanvas_SizeChanged"/>
                                <Slider x:Name="AudioSlider" Grid.Row="1" Style="{StaticResource TimelineSlider}"
                                        Minimum="0" Maximum="1"
                                        ValueChanged="AudioSlider_ValueChanged"/>
                            </Grid>

                            <TextBlock x:Name="TotalTimeText" Grid.Column="3" Text="00:00" Width="52"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>

                            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                    Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="재생 중 해당 시점에 작성한 메모가 흰색 테두리로 표시됩니다.&#x0a;Ctrl+클릭으로 메모를 누르면 그 시점부터 재생합니다.">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="1.5"
                                               RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MarkCountText" Text="연결된 메모 0" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 빈 상태 -->
                    <Grid x:Name="EmptyState" Grid.RowSpan="4" Background="{StaticResource BgBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="메모를 선택하거나 새로 만들어 보세요" Foreground="{StaticResource TextBrush}"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="녹음하면서 메모하면, 재생할 때 그 시점에 쓴 부분이 표시됩니다"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <Button Content="새 메모 만들기" Click="NewMemo_Click" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Margin="0,20,0,0" Padding="18,9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===== 비밀번호 입력 화면 ===== -->
            <Grid x:Name="PasswordPanel" Grid.Row="1" Background="{StaticResource BgBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Width="400" Padding="32,24" CornerRadius="14" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,16"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LockTitle" Text="SecureMemo" Foreground="{StaticResource TextBrush}" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,12,0,6" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LockDesc" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   Margin="0,0,0,16" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                                   Text="비밀번호를 입력하세요.&#x0a;처음 사용하는 비밀번호는 새 메모 공간이 됩니다."/>

                        <TextBlock Text="비밀번호" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}"
                                     KeyDown="PasswordBox_KeyDown"/>

                        <StackPanel x:Name="ConfirmArea" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="비밀번호 확인" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordInput}"
                                         KeyDown="PasswordBox_KeyDown"/>
                        </StackPanel>

                        <!-- 복구 불가 경고 -->
                        <Border Background="#2b2415" BorderBrush="#4a3b1c" BorderThickness="1" CornerRadius="8"
                                Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="#e8b04b" Margin="0,1,10,0"/>
                                <TextBlock Grid.Column="1" Foreground="#e8c27a" FontSize="12" TextWrapping="Wrap"
                                           LineHeight="18"
                                           Text="본 암호를 잊어버릴 경우 저장한 메모는 복구 방법이 없습니다. 메모와 녹음은 이 암호로 암호화되어 저장됩니다."/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="LoginButton" Content="열기" Click="Login_Click" Margin="0,10,0,0" Height="40"
                                FontSize="14" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="BackButton" Content="다른 비밀번호 입력" Click="Back_Click" Margin="0,6,0,0"
                                Style="{StaticResource GhostButton}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </Grid>

            <!-- ===== 토스트 알림 ===== -->
            <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,84" Padding="16,10" CornerRadius="8" Background="#30303a"
                    BorderBrush="#3e3e4a" BorderThickness="1"
                    IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="13"/>
            </Border>
        </Grid>
    </Border>
</Window>
