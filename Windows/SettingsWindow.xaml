<Window x:Class="SecureMemo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="520" Width="600"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1a1a1a" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀바 -->
        <Border Grid.Row="0" Background="#1a1a1a" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="설정" Foreground="#888" FontSize="13" 
                           VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="×" Width="46" Height="32" Click="CloseButton_Click"
                        HorizontalAlignment="Right" FontSize="16"
                        Style="{StaticResource ModernButton}"/>
            </Grid>
        </Border>

        <!-- 설정 내용 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- 비밀번호 설정 -->
                <Border Background="#2a2a2a" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="비밀번호 보호" Foreground="#e0e0e0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <CheckBox x:Name="UsePasswordCheckBox" Content="비밀번호 사용" 
                                  Foreground="#e0e0e0" Margin="0,0,0,12"
                                  Checked="UsePasswordCheckBox_Checked"
                                  Unchecked="UsePasswordCheckBox_Unchecked"/>

                        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                            <TextBlock Text="비밀번호" Foreground="#888" FontSize="13" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="NewPasswordBox" Grid.Column="0"
                                             Background="#1a1a1a" Foreground="#e0e0e0"
                                             BorderBrush="#3a3a3a" Padding="8" Height="36"/>
                                <TextBox x:Name="NewPasswordTextBox" Grid.Column="0"
                                         Background="#1a1a1a" Foreground="#e0e0e0"
                                         BorderBrush="#3a3a3a" Padding="8" Height="36"
                                         Visibility="Collapsed"/>
                                <Button Grid.Column="1" Content="👁" Width="40" Height="36"
                                        Click="TogglePasswordVisibility_Click"
                                        Style="{StaticResource ModernButton}" Margin="4,0,0,0"/>
                            </Grid>

                            <Button Content="비밀번호 설정" Click="SetPassword_Click"
                                    Background="#6366f1" Foreground="White"
                                    Style="{StaticResource ModernButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI 자동 설정 -->
                <Border Background="#2a2a2a" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="AI 설정 (Gemma 4 E2B - 로컬)" Foreground="#e0e0e0" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Ollama + Gemma 4 E2B 모델을 자동으로 설치합니다" Foreground="#666" FontSize="12" Margin="0,0,0,12"/>

                        <Button x:Name="AutoSetupButton" Content="🚀 원클릭 AI 설정" Click="AutoSetup_Click"
                                Background="#10b981" Foreground="White" FontSize="14" FontWeight="Bold"
                                Style="{StaticResource ModernButton}" Margin="0,0,0,8" Padding="16,10"/>

                        <ProgressBar x:Name="SetupProgressBar" Height="6" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" Margin="0,0,0,4"
                                     Foreground="#10b981" Background="#1a1a1a"/>

                        <TextBlock x:Name="SetupStatusText" Foreground="#888" FontSize="12" 
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="TestApiButton" Content="연결 테스트" Click="TestApi_Click"
                                Style="{StaticResource ModernButton}" Margin="0,8,0,0"
                                Visibility="Collapsed"/>

                        <TextBlock x:Name="ApiTestResult" Foreground="#888" FontSize="12" 
                                   Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 정보 -->
                <Border Background="#2a2a2a" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="업데이트" Foreground="#e0e0e0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <TextBlock x:Name="VersionText" Foreground="#888" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click"
                                Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="UpdateStatusText" Foreground="#888" FontSize="12" 
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>
                        
                        <ProgressBar x:Name="UpdateProgressBar" Height="4" 
                                     Visibility="Collapsed" Margin="0,0,0,8"/>
                        
                        <Button x:Name="InstallUpdateButton" Content="업데이트 설치" Click="InstallUpdate_Click"
                                Visibility="Collapsed" Background="#6366f1" Foreground="White"
                                Style="{StaticResource ModernButton}"/>
                    </StackPanel>
                </Border>

                <!-- 정보 -->
                <Border Background="#2a2a2a" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="정보" Foreground="#e0e0e0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Foreground="#888" FontSize="13" TextWrapping="Wrap">
                            <Run Text="SecureMemo"/><LineBreak/>
                            <Run Text="모든 데이터는 로컬에 암호화되어 저장됩니다."/><LineBreak/>
                            <Run Text="비밀번호를 잊어버리면 데이터를 복구할 수 없습니다."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
