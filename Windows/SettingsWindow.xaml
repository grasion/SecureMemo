<Window x:Class="SecureMemo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="540" Width="520"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타이틀바 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="설정" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="32" Height="28" Style="{StaticResource GhostButton}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,4,20,20">

                    <!-- 내보내기 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="모든 메모 Word로 내보내기" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ExportDescText" Style="{StaticResource SectionDesc}"
                                       Text="현재 메모 공간의 모든 메모를 하나의 Word 문서로 저장합니다. (메모마다 새 페이지)"/>
                            <Button x:Name="ExportAllButton" Click="ExportAll_Click" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="모든 메모 내보내기" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ExportStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 업데이트 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="업데이트" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource SectionDesc}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click"
                                        Style="{StaticResource ModernButton}" Background="#30303a"/>
                                <Button x:Name="InstallUpdateButton" Content="업데이트 설치" Click="InstallUpdate_Click"
                                        Visibility="Collapsed" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>

                            <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>

                            <ProgressBar x:Name="UpdateProgressBar" Height="4" Margin="0,8,0,0"
                                         Foreground="{StaticResource AccentBrush}" Background="#30303a"
                                         BorderThickness="0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 정보 -->
                    <Border Style="{StaticResource SectionCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="정보" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       LineHeight="20">
                                <Run Text="SecureMemo"/><LineBreak/>
                                <Run Text="메모와 녹음은 입력한 비밀번호로 암호화되어 이 PC에만 저장되며 외부로 전송되지 않습니다."/><LineBreak/>
                                <Run Text="비밀번호마다 별도의 메모 공간이 만들어집니다."/><LineBreak/>
                                <Run Text="비밀번호를 잊어버리면 저장한 메모는 복구할 방법이 없습니다." Foreground="#e8b04b"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
